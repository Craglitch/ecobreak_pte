---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const isAbout = currentPath === '/about';
const isSej = currentPath === '/sej';
const isUp = currentPath === '/update';

// Import logo from src/assets
import logo from "../assets/logo.jpg";
---

<nav class="bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-green-100/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2 group">
          <img 
            src={logo.src} 
            alt="EcoBrick Logo" 
            class="h-8 w-8 md:h-10 md:w-10 object-contain"
          />
          <span class="text-green-800 font-bold text-xl tracking-tight">
            EcoBrick Penanti
          </span>
          <span class="text-[10px] uppercase tracking-[0.2em] text-green-600 font-light hidden sm:block">
            DIGITAL
          </span>
        </a>
      </div>


      <!-- Desktop Navigation -->
      <div class="hidden md:flex space-x-1 sm:space-x-2">

        <a 
          href="/" 
          class:list={[
            'px-3 sm:px-5 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300',
            'tracking-wide',
            isHome 
              ? 'bg-green-800 text-white shadow-lg shadow-green-800/20' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          🏠 Home
        </a>


        <a 
          href="/about" 
          class:list={[
            'px-3 sm:px-5 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300',
            'tracking-wide',
            isAbout 
              ? 'bg-green-800 text-white shadow-lg shadow-green-800/20' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          ℹ️ About
        </a>


        <a 
          href="/sej" 
          class:list={[
            'px-3 sm:px-5 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300',
            'tracking-wide',
            isSej
              ? 'bg-green-800 text-white shadow-lg shadow-green-800/20' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          📜 History
        </a>


        <!-- ADDED PROGRESS -->
        <a 
          href="/update" 
          class:list={[
            'px-3 sm:px-5 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300',
            'tracking-wide',
            isUp
              ? 'bg-green-800 text-white shadow-lg shadow-green-800/20' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          📈 Progress
        </a>


      </div>



      <!-- Mobile Hamburger Menu -->
      <div class="md:hidden">
        <button 
          id="menu-toggle"
          class="p-2 rounded-lg text-green-700 hover:bg-green-50 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-green-500"
          aria-label="Toggle menu"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>


    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="md:hidden hidden py-2 border-t border-green-100/30">

      <div class="flex flex-col space-y-1">


        <a 
          href="/" 
          class:list={[
            'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
            'tracking-wide',
            isHome 
              ? 'bg-green-800 text-white' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          🏠 Home
        </a>


        <a 
          href="/about" 
          class:list={[
            'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
            'tracking-wide',
            isAbout 
              ? 'bg-green-800 text-white' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          ℹ️ About
        </a>


        <a 
          href="/sej" 
          class:list={[
            'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
            'tracking-wide',
            isSej
              ? 'bg-green-800 text-white' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          📜 HISTORY
        </a>


        <a 
          href="/update" 
          class:list={[
            'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300',
            'tracking-wide',
            isUp
              ? 'bg-green-800 text-white' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          📈 Progress
        </a>


      </div>
    </div>

  </div>
</nav>


<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
