---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const isAbout = currentPath === '/about';
const isSej = currentPath === '/sej';
---

<!-- Remove all inline font-family styles -->
<nav class="bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-green-100/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-2xl">🌿</span>
          <!-- Removed inline font-family -->
          <span class="text-green-800 font-bold text-xl tracking-tight">
            EcoBrick
          </span>
          <span class="text-[10px] uppercase tracking-[0.2em] text-green-600 font-light hidden sm:block">
            PENANTI
          </span>
        </a>
      </div>

      <div class="flex space-x-1 sm:space-x-2">
        <a 
          href="/" 
          class:list={[
            'px-3 sm:px-5 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300',
            'tracking-wide',
            isHome 
              ? 'bg-green-800 text-white shadow-lg shadow-green-800/20' 
              : 'text-green-700 hover:bg-green-50 hover:text-green-900'
          ]}
        >
          🏠 Home
        </a>

        <a 
          href="/about" 
          class:list={[
            'px-3 sm:px-5 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300',
            'tracking-wide',
            isAbout 
              ? 'bg-green-800 text-white shadow-lg shadow-green-800/20' 
              : 'text-green-700 hover:bg-green-50 hover:txt-green-900'
          ]}
        >
          ℹ️ About
        </a>
        <a 
          href="/sej" 
          class:list={[
            'px-3 sm:px-5 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300',
            'tracking-wide',
            isSej
              ? 'bg-green-800 text-white shadow-lg shadow-green-800/20' 
              : 'text-green-700 hover:bg-green-50 hover:txt-green-900'
          ]}
        >
          📜 Sej

        </a>

      </div>

    </div>
  </div>
</nav>
