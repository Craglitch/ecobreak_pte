---
import Layout from "../layouts/Layout.astro";

const researchData = [
  {
    week: "Week 1",
    date: "19/7/26 - 24/7/26",
    plasticWeight: "0.85 kg",
    bottles: 12,
    ecobricks: 12,
    bottleSize: "250 ml",
    icon: "🌱",
    description: "Initial plastic waste collection and EcoBrick production."
  },
  {
    week: "Week 2",
    date: "17/8/26 - 21/8/26",
    plasticWeight: "1.426 kg",
    bottles: 21,
    ecobricks: 17,
    bottleSize: "500 ml",
    icon: "♻️",
    description: "Increased collection of plastic waste and EcoBrick production."
  },
  {
    week: "Week 3",
    date: "22/8/26 - 28/8/26",
    plasticWeight: "8.195 kg",
    bottles: 96,
    ecobricks: 28,
    bottleSize: "500 ml",
    icon: "🌍",
    description: "Significant growth in plastic waste collection and EcoBrick production."
  }
];

const totalPlasticWeight = "10.471 kg";
const totalBottles = 129;
const totalEcobricks = 57;
---

<Layout>
  <section class="relative min-h-screen overflow-hidden bg-gradient-to-br from-green-50 via-white to-emerald-50/50">

    <!-- Background Decorations -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-20 right-10 h-40 w-40 rounded-full bg-green-200/30 blur-3xl"></div>
      <div class="absolute bottom-20 left-10 h-56 w-56 rounded-full bg-emerald-100/40 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-green-100/20 blur-3xl"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">

      <!-- Header -->
      <div class="mx-auto max-w-5xl text-center animate-fade-in">

        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-100/80 px-6 py-2 shadow-sm backdrop-blur-sm">
          <span class="text-sm font-semibold tracking-wider text-green-700">
            🔬 ACTION RESEARCH 2026
          </span>
        </div>

        <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-green-800 sm:text-4xl md:text-5xl lg:text-6xl">
          EcoBrick Penanti Digital + AI
        </h1>

        <p class="mx-auto mt-6 max-w-4xl text-base leading-relaxed text-gray-600 sm:text-lg md:text-xl">
          A Student-Led Action Research Model for Transforming Plastic Waste into
          Sustainable School Spaces Among Form Six Students at SMK Penanti,
          Pulau Pinang
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <span class="rounded-full bg-white px-5 py-2 text-sm font-medium text-green-700 shadow-md ring-1 ring-green-100">
            🏫 SMK Penanti
          </span>

          <span class="rounded-full bg-white px-5 py-2 text-sm font-medium text-green-700 shadow-md ring-1 ring-green-100">
            🎓 Form Six Students
          </span>

          <span class="rounded-full bg-white px-5 py-2 text-sm font-medium text-green-700 shadow-md ring-1 ring-green-100">
            🤖 Digital + AI
          </span>

          <span class="rounded-full bg-white px-5 py-2 text-sm font-medium text-green-700 shadow-md ring-1 ring-green-100">
            ♻️ Sustainability
          </span>
        </div>
      </div>


      <!-- Overall Statistics -->
      <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-3">

        <!-- Total Plastic -->
        <div class="group rounded-3xl border border-green-100 bg-white/90 p-8 text-center shadow-lg backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">

          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-green-100 to-emerald-100 text-4xl shadow-md transition-transform duration-300 group-hover:scale-110">
            🗑️
          </div>

          <p class="mt-5 text-sm font-semibold uppercase tracking-widest text-gray-400">
            Total Plastic Waste
          </p>

          <h2 class="mt-2 text-4xl font-extrabold text-green-700">
            {totalPlasticWeight}
          </h2>

          <p class="mt-2 text-sm text-gray-500">
            Collected throughout the research
          </p>

        </div>


        <!-- Total Bottles -->
        <div class="group rounded-3xl border border-green-100 bg-white/90 p-8 text-center shadow-lg backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">

          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-green-100 to-emerald-100 text-4xl shadow-md transition-transform duration-300 group-hover:scale-110">
            🍶
          </div>

          <p class="mt-5 text-sm font-semibold uppercase tracking-widest text-gray-400">
            Total Bottles
          </p>

          <h2 class="mt-2 text-4xl font-extrabold text-green-700">
            {totalBottles}
          </h2>

          <p class="mt-2 text-sm text-gray-500">
            Bottles collected and recorded
          </p>

        </div>


        <!-- Total Ecobricks -->
        <div class="group rounded-3xl border border-green-100 bg-white/90 p-8 text-center shadow-lg backdrop-blur-sm transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">

          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-green-100 to-emerald-100 text-4xl shadow-md transition-transform duration-300 group-hover:scale-110">
            🧱
          </div>

          <p class="mt-5 text-sm font-semibold uppercase tracking-widest text-gray-400">
            Total EcoBricks
          </p>

          <h2 class="mt-2 text-4xl font-extrabold text-green-700">
            {totalEcobricks}
          </h2>

          <p class="mt-2 text-sm text-gray-500">
            EcoBricks successfully produced
          </p>

        </div>

      </div>


      <!-- Section Title -->
      <div class="mt-20 text-center animate-fade-in">

        <div class="mb-4 text-4xl">
          📊
        </div>

        <h2 class="text-3xl font-bold text-green-800 md:text-4xl">
          Action Research Progress
        </h2>

        <p class="mx-auto mt-3 max-w-2xl text-gray-600">
          Weekly monitoring of plastic waste collection and EcoBrick production.
        </p>

      </div>


      <!-- Research Timeline -->
      <div class="relative mt-16">

        <!-- Desktop Vertical Line -->
        <div class="absolute bottom-0 top-0 left-1/2 hidden w-1 -translate-x-1/2 bg-gradient-to-b from-green-400 via-green-500 to-emerald-600 md:block"></div>

        <div class="space-y-12">

          {researchData.map((item, index) => (

            <div
              class={`relative flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10 ${
                index % 2 === 0 ? "" : ""
              }`}
            >

              <!-- Timeline Dot -->
              <div class="absolute left-1/2 top-8 z-10 hidden h-6 w-6 -translate-x-1/2 rounded-full border-4 border-white bg-green-500 shadow-lg md:block"></div>


              <!-- Left Side -->
              {index % 2 === 0 ? (

                <>
                  <div class="w-full md:w-1/2 md:pr-10">

                    <div class="group rounded-3xl border-r-4 border-green-500 bg-white p-7 shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl md:text-right">

                      <div class="flex items-center gap-4 md:justify-end">

                        <div>
                          <span class="rounded-full bg-green-100 px-4 py-2 text-sm font-bold text-green-700">
                            {item.week}
                          </span>

                          <p class="mt-3 text-sm font-medium text-gray-400">
                            📅 {item.date}
                          </p>
                        </div>

                        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-green-100 to-emerald-100 text-3xl shadow-md transition-transform group-hover:scale-110">
                          {item.icon}
                        </div>

                      </div>

                      <p class="mt-6 text-lg font-semibold text-green-800">
                        {item.description}
                      </p>

                      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">

                        <div class="rounded-2xl bg-green-50 p-4">
                          <p class="text-xs font-medium text-gray-400">
                            PLASTIC
                          </p>
                          <p class="mt-1 text-lg font-bold text-green-700">
                            {item.plasticWeight}
                          </p>
                        </div>

                        <div class="rounded-2xl bg-green-50 p-4">
                          <p class="text-xs font-medium text-gray-400">
                            BOTTLES
                          </p>
                          <p class="mt-1 text-lg font-bold text-green-700">
                            {item.bottles}
                          </p>
                        </div>

                        <div class="rounded-2xl bg-green-50 p-4">
                          <p class="text-xs font-medium text-gray-400">
                            ECOBRICKS
                          </p>
                          <p class="mt-1 text-lg font-bold text-green-700">
                            {item.ecobricks}
                          </p>
                        </div>

                      </div>

                      <div class="mt-5">
                        <span class="rounded-full bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700">
                          🍶 Bottle Size: {item.bottleSize}
                        </span>
                      </div>

                    </div>

                  </div>

                  <div class="hidden md:block md:w-1/2"></div>
                </>

              ) : (

                <>
                  <div class="hidden md:block md:w-1/2"></div>

                  <div class="w-full md:w-1/2 md:pl-10">

                    <div class="group rounded-3xl border-l-4 border-green-500 bg-white p-7 shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">

                      <div class="flex items-center gap-4">

                        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-green-100 to-emerald-100 text-3xl shadow-md transition-transform group-hover:scale-110">
                          {item.icon}
                        </div>

                        <div>
                          <span class="rounded-full bg-green-100 px-4 py-2 text-sm font-bold text-green-700">
                            {item.week}
                          </span>

                          <p class="mt-3 text-sm font-medium text-gray-400">
                            📅 {item.date}
                          </p>
                        </div>

                      </div>

                      <p class="mt-6 text-lg font-semibold text-green-800">
                        {item.description}
                      </p>

                      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">

                        <div class="rounded-2xl bg-green-50 p-4">
                          <p class="text-xs font-medium text-gray-400">
                            PLASTIC
                          </p>
                          <p class="mt-1 text-lg font-bold text-green-700">
                            {item.plasticWeight}
                          </p>
                        </div>

                        <div class="rounded-2xl bg-green-50 p-4">
                          <p class="text-xs font-medium text-gray-400">
                            BOTTLES
                          </p>
                          <p class="mt-1 text-lg font-bold text-green-700">
                            {item.bottles}
                          </p>
                        </div>

                        <div class="rounded-2xl bg-green-50 p-4">
                          <p class="text-xs font-medium text-gray-400">
                            ECOBRICKS
                          </p>
                          <p class="mt-1 text-lg font-bold text-green-700">
                            {item.ecobricks}
                          </p>
                        </div>

                      </div>

                      <div class="mt-5">
                        <span class="rounded-full bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700">
                          🍶 Bottle Size: {item.bottleSize}
                        </span>
                      </div>

                    </div>

                  </div>
                </>

              )}

            </div>

          ))}

        </div>

      </div>


      <!-- Research Conclusion -->
      <div class="mt-20 animate-fade-in">

        <div class="rounded-3xl bg-gradient-to-r from-green-600 to-emerald-600 p-8 text-center text-white shadow-2xl shadow-green-600/30 md:p-12">

          <div class="text-5xl">
            🌱
          </div>

          <h2 class="mt-5 text-2xl font-bold md:text-4xl">
            From Plastic Waste to Sustainable School Spaces
          </h2>

          <p class="mx-auto mt-5 max-w-3xl text-base leading-relaxed text-green-100 md:text-lg">
            EcoBrick Penanti Digital + AI demonstrates how student-led action
            research can transform plastic waste into meaningful sustainable
            resources while promoting innovation, digital learning and
            environmental responsibility.
          </p>

          <div class="mt-8 flex flex-wrap justify-center gap-4">

            <div class="rounded-full bg-white/20 px-6 py-3 text-sm font-semibold backdrop-blur-sm">
              ♻️ 10.471 kg Plastic Waste Recorded
            </div>

            <div class="rounded-full bg-white/20 px-6 py-3 text-sm font-semibold backdrop-blur-sm">
              🍶 129 Bottles Collected
            </div>

            <div class="rounded-full bg-white/20 px-6 py-3 text-sm font-semibold backdrop-blur-sm">
              🧱 57 EcoBricks Produced
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>
</Layout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>
