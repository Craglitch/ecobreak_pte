---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

// Import 3 JPG images
import anatomyImage from "../assets/anatomi-ecobrick.jpg";
import sasaranImage from "../assets/sasaran-tahun.jpg";
import unjuranImage from "../assets/unjuran-tahun.jpg"
---

<Layout>
  <section class="relative overflow-hidden py-12 md:py-20">
    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-green-50 via-white to-emerald-50/50 -z-10"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-green-200/20 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-emerald-100/20 rounded-full blur-3xl -z-10"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-block bg-green-100/80 backdrop-blur-sm px-6 py-2 rounded-full mb-4">
          <span class="text-green-700 text-sm font-medium tracking-wider">🌿 TENTANG KAMI</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-green-800">
          Projek EcoBrick SMK Penanti
        </h1>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
          Mengubah sisa plastik kepada bahan binaan lestari untuk masa depan yang lebih hijau
        </p>
      </div>

      <!-- 3 Infographic Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        
        <!-- Card 1: Anatomi EcoBrick -->
        <Card 
          title="Anatomi EcoBrick"
          description="Mengubah sisa berongga menjadi bahan binaan berketumpatan tinggi"
          imageSrc={anatomyImage.src}
          imageAlt="Anatomi EcoBrick"
          badge="Infografik"
          tags={['Struktur', 'Binaan', 'Lestari']}
        />

        <!-- Card 2: Sasaran Satu Tahun -->
        <Card 
          title="Sasaran Satu Tahun"
          description="Bersama membina masa depan lestari"
          imageSrc={sasaranImage.src}
          imageAlt="Sasaran Satu Tahun"
          badge="Target"
          tags={['Matlamat', '2026', 'Hijau']}
        />

        <!-- Card 3: Unjuran Tahun Pertama -->
        <Card 
          title="Unjuran Tahun Pertama"
          description="Mencipta transformasi berskala makro bermula dari tangan pelajar"
          imageSrc={unjuranImage.src}
          imageAlt="Unjuran Tahun Pertama"
          badge="Pencapaian"
          tags={['Statistik', 'Impak', 'Transformasi']}
        />

      </div>

      <!-- Vision Statement -->
      <div class="bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl p-8 md:p-12 text-white shadow-xl shadow-green-600/30 mb-12">
        <div class="flex items-center gap-4 mb-4">
          <span class="text-4xl">🎯</span>
          <h2 class="text-2xl md:text-3xl font-bold">Unjuran Tahun Pertama</h2>
        </div>
        <p class="text-green-100 text-lg leading-relaxed">
          Mencipta transformasi berskala makro bermula dari tangan pelajar.
        </p>
        <div class="mt-6 text-sm text-green-200">
          Dalam tempoh setahun:
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16">
        
        <div class="bg-white rounded-2xl p-6 text-center shadow-lg border border-green-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-3xl md:text-4xl font-bold text-green-700">8,000</div>
          <div class="text-sm text-gray-600 mt-2">Botol dikitar semula</div>
          <div class="text-xs text-gray-400 mt-1">(diselamatkan dari tapak pelupusan)</div>
        </div>

        <div class="bg-white rounded-2xl p-6 text-center shadow-lg border border-green-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-3xl md:text-4xl font-bold text-green-700">20</div>
          <div class="text-sm text-gray-600 mt-2">Bangku EcoBrick</div>
          <div class="text-xs text-gray-400 mt-1">kukuh siap dipasang</div>
        </div>

        <div class="bg-white rounded-2xl p-6 text-center shadow-lg border border-green-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-3xl md:text-4xl font-bold text-green-700">50</div>
          <div class="text-sm text-gray-600 mt-2">Pasu bunga</div>
          <div class="text-xs text-gray-400 mt-1">dibina dan dimanfaatkan</div>
        </div>

        <div class="bg-white rounded-2xl p-6 text-center shadow-lg border border-green-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-3xl md:text-4xl font-bold text-green-700">300</div>
          <div class="text-sm text-gray-600 mt-2">Pelajar terlibat</div>
          <div class="text-xs text-gray-400 mt-1">secara langsung dalam pelaksanaan projek</div>
        </div>

      </div>

      <!-- Matlamat Akhir -->
      <div class="bg-green-50 rounded-2xl p-8 md:p-10 text-center border-2 border-green-200 mb-16">
        <span class="text-4xl block mb-3">🏆</span>
        <h3 class="text-2xl md:text-3xl font-bold text-green-800">Matlamat Akhir</h3>
        <p class="text-xl text-green-700 font-semibold mt-2">
          Menobatkan SMK Penanti dengan status <span class="bg-green-200 px-4 py-1 rounded-full">Sekolah Hijau</span>
        </p>
      </div>

      <!-- Anatomy of Ecobrick -->
      <div class="mb-16">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-green-800">Anatomi EcoBrick</h2>
          <p class="text-gray-600 mt-2">Mengubah sisa berongga menjadi bahan binaan berketumpatan tinggi</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Lapisan Luar -->
          <div class="bg-white rounded-2xl p-6 shadow-lg border-l-4 border-green-600">
            <h3 class="text-xl font-bold text-green-800 flex items-center gap-2">
              <span>🛡️</span> Lapisan Luar (Cengkerang)
            </h3>
            <p class="text-gray-600 mt-3 leading-relaxed">
              Botol plastik terpakai yang bertindak sebagai catuan kalis cuaca. Pelajar bertanggungjawab mengumpul bahan ini secara aktif.
            </p>
          </div>

          <!-- Teras Dalaman -->
          <div class="bg-white rounded-2xl p-6 shadow-lg border-l-4 border-emerald-600">
            <h3 class="text-xl font-bold text-green-800 flex items-center gap-2">
              <span>🧱</span> Teras Dalaman (Bahan Mampat)
            </h3>
            <p class="text-gray-600 mt-3 leading-relaxed">
              Sisa plastik sekali guna dan pembungkus makanan yang disusun padat.
            </p>
          </div>

          <!-- Mekanik Pemadatan -->
          <div class="bg-white rounded-2xl p-6 shadow-lg border-l-4 border-green-600 md:col-span-2">
            <h3 class="text-xl font-bold text-green-800 flex items-center gap-2">
              <span>⚡</span> Mekanik Pemadatan
            </h3>
            <p class="text-gray-600 mt-3 leading-relaxed">
              Daya mampatan maksimum menggunakan kayu pemekat, menghilangkan ruang udara untuk mencapai integriti struktur setara batu bata atau konkrit.
            </p>
          </div>

        </div>
      </div>

      <!-- Aplikasi Ecobrick -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-green-800 text-center mb-8">Aplikasi EcoBrick dalam Pembinaan</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          
          <div class="bg-white rounded-2xl p-6 text-center shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2 border border-green-100">
            <span class="text-4xl block mb-3">🪑</span>
            <h4 class="font-bold text-green-700">Bangku Taman</h4>
            <p class="text-xs text-gray-500 mt-1">Kukuh, tahan lasak dan mesra alam</p>
          </div>

          <div class="bg-white rounded-2xl p-6 text-center shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2 border border-green-100">
            <span class="text-4xl block mb-3">🌺</span>
            <h4 class="font-bold text-green-700">Pasu Bunga</h4>
            <p class="text-xs text-gray-500 mt-1">Ringan, cantik dan boleh dikitar semula</p>
          </div>

          <div class="bg-white rounded-2xl p-6 text-center shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2 border border-green-100">
            <span class="text-4xl block mb-3">🧱</span>
            <h4 class="font-bold text-green-700">Tembok Landskap</h4>
            <p class="text-xs text-gray-500 mt-1">Stabil, kuat dan cegah hakisan tanah</p>
          </div>

          <div class="bg-white rounded-2xl p-6 text-center shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2 border border-green-100">
            <span class="text-4xl block mb-3">📚</span>
            <h4 class="font-bold text-green-700">Sudut Bacaan & Hiasan</h4>
            <p class="text-xs text-gray-500 mt-1">Kreatif, fungsional dan menceriakan</p>
          </div>

        </div>
      </div>

      <!-- Kelebihan Ecobrick -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-green-800 text-center mb-8">Kelebihan EcoBrick</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <div class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-green-600">
            <span class="text-4xl block mb-3">🏗️</span>
            <h4 class="font-bold text-green-700">Kukuh & Tahan Lama</h4>
            <p class="text-sm text-gray-500 mt-1">Struktur stabil seperti batu bata atau konkrit</p>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-emerald-600">
            <span class="text-4xl block mb-3">🌍</span>
            <h4 class="font-bold text-green-700">Mesra Alam</h4>
            <p class="text-sm text-gray-500 mt-1">Mengurangkan sisa plastik ke tapak pelupusan</p>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-green-600">
            <span class="text-4xl block mb-3">💰</span>
            <h4 class="font-bold text-green-700">Jimati Kos</h4>
            <p class="text-sm text-gray-500 mt-1">Alternatif binaan yang lebih ekonomi</p>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-emerald-600">
            <span class="text-4xl block mb-3">🤝</span>
            <h4 class="font-bold text-green-700">Libat Urus Komuniti</h4>
            <p class="text-sm text-gray-500 mt-1">Pelajar, guru & komuniti bekerjasama</p>
          </div>

        </div>
      </div>

      <!-- Sasaran Satu Tahun -->
      <div class="mb-16">
        <div class="bg-gradient-to-r from-green-700 to-emerald-700 rounded-2xl p-8 md:p-12 text-white shadow-xl">
          <h2 class="text-3xl font-bold text-center mb-8">Sasaran Satu Tahun</h2>
          <p class="text-center text-green-200 mb-8">Bersama membina masa depan lestari.</p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center">
              <span class="text-4xl block mb-3">♻️</span>
              <h4 class="font-bold text-white">Sisa Plastik</h4>
              <p class="text-green-200 text-sm mt-1">Mengumpul sisa plastik seperti botol, pembalut dan bahan buangan lain</p>
            </div>

            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center">
              <span class="text-4xl block mb-3">🌿</span>
              <h4 class="font-bold text-white">Hijaukan Persekitaran</h4>
              <p class="text-green-200 text-sm mt-1">Menggunakan EcoBrick untuk pasu bunga dan projek landskap sekolah</p>
            </div>

            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center">
              <span class="text-4xl block mb-3">🏫</span>
              <h4 class="font-bold text-white">Komuniti Lestari</h4>
              <p class="text-green-200 text-sm mt-1">Kita bina hari ini, untuk masa depan lestari!</p>
            </div>

          </div>
        </div>
      </div>

      <!-- Target & Aktiviti -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        
        <div class="bg-white rounded-2xl p-8 shadow-lg border border-green-100">
          <h3 class="text-2xl font-bold text-green-800 flex items-center gap-2 mb-4">
            <span>🎯</span> Target
          </h3>
          <p class="text-gray-700 font-semibold">Sasaran Utama</p>
          <p class="text-gray-600 mt-1">Membina komuniti sekolah yang hijau dan lestari melalui projek EcoBrick.</p>
          
          <div class="mt-4">
            <p class="text-sm font-semibold text-green-700">Bimbingan:</p>
            <div class="flex flex-wrap gap-2 mt-2">
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Guru</span>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Komuniti</span>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Kulpi</span>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Cuci</span>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Kering</span>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Mampat</span>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">Bina</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg border border-green-100">
          <h3 class="text-2xl font-bold text-green-800 flex items-center gap-2 mb-4">
            <span>📋</span> Aktiviti & Impak
          </h3>
          
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <span class="text-green-600">✅</span>
              <div>
                <p class="font-medium text-gray-700">Perkongsian bersih</p>
                <p class="text-sm text-gray-500">Komuniti lestari</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-600">✅</span>
              <div>
                <p class="font-medium text-gray-700">Pendidikan alam sekitar</p>
                <p class="text-sm text-gray-500">Kesedaran pelajar</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-600">✅</span>
              <div>
                <p class="font-medium text-gray-700">Projek infrastruktur hijau</p>
                <p class="text-sm text-gray-500">Bangku, pasu dan landskap</p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Bottom Section -->
      <div class="bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl p-8 md:p-12 text-white shadow-xl shadow-green-600/30 text-center">
        <div class="flex flex-wrap justify-center gap-6 md:gap-12">
          <div>
            <div class="text-4xl font-bold">300</div>
            <div class="text-sm text-green-200 mt-1">Pelajar Aktif</div>
          </div>
          <div>
            <div class="text-4xl font-bold">♻️</div>
            <div class="text-sm text-green-200 mt-1">Kurangkan Sisa Plastik</div>
          </div>
          <div>
            <div class="text-4xl font-bold">💰</div>
            <div class="text-sm text-green-200 mt-1">Jimati Sumber</div>
          </div>
          <div>
            <div class="text-4xl font-bold">🌍</div>
            <div class="text-sm text-green-200 mt-1">Pelihara Alam Sekitar</div>
          </div>
          <div>
            <div class="text-4xl font-bold">🤝</div>
            <div class="text-sm text-green-200 mt-1">Bina Komuniti Lestari</div>
          </div>
        </div>
        
        <div class="mt-8 pt-8 border-t border-green-400/30">
          <p class="text-xl md:text-2xl font-bold tracking-wide">
            "DARI SISA KE LESTARI, BERSAMA MEMBINA MASA DEPAN!"
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>
